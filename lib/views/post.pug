extends layout

block title
  title #{post.title} | www.thecodebarbarian.com

block opengraphTags
  meta( property="og:title",
        content=post.title)
  meta( property="og:url",
        content='http://www.thecodebarbarian.com' + post.dest.directory.substr('./bin'.length) + '/' + post.dest.name)
  meta( property="og:image",
        content=post.image || '/images/Barbarian_Head.png')
  meta( property="og:site_name",
        content="The Code Barbarian")
  meta( property="description", content=post.previewText || post.rawPreview)
  meta(name="twitter:image", content=post.image || '/images/Barbarian_Head.png')
  meta(name="twitter:card", content="summary_large_image")

block content
  - var shareUrl = encodeURIComponent('http://www.thecodebarbarian.com' + post.url);
  .post-layout
    article.post
      header.post-header
        p.post-meta
          span= post.date.format('MMMM D, YYYY')
          if post.topic
            span(aria-hidden="true") |
            span= post.topic
        h1.post-title= post.title
        p.post-byline
          | by Valeri Karpov
        if post.code
          a.post-code-link(href=post.code) View the code for this post on GitHub

      script(type="text/javascript", src="/js/native.js")
      div.

        <script src="//m.servedby-buysellads.com/monetization.js" type="text/javascript"></script>

        <div class="native-banner"></div>

      <script async type="text/javascript" src="//cdn.carbonads.com/carbon.js?serve=CKYI5K3Y&placement=thecodebarbariancom" id="_carbonads_js"></script>
      .prose !{content}

      footer.post-footer
        p
          | Found a typo or error? Open up a pull request! This post is
          | available as markdown on&nbsp;
          a(href='https://github.com/vkarpov15/thecodebarbarian.com/blob/master/lib/posts/' + post.src.substr('./lib/posts/'.length))
            | GitHub
        p.post-share
          span Share
          a(href='https://twitter.com/share?url=' + shareUrl + '&via=code_barbarian') Twitter
          a(href='https://www.facebook.com/sharer/sharer.php?u=' + shareUrl) Facebook
          a(href="#disqus_thread") Comments

      div#disqus_thread
      script(type="text/javascript").
        /* * * CONFIGURATION VARIABLES: EDIT BEFORE PASTING INTO YOUR WEBPAGE * * */
        var disqus_shortname = 'codebarbarian'; // required: replace example with your forum shortname

        /* * * DON'T EDIT BELOW THIS LINE * * */
        (function() {
            var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
            dsq.src = '//' + disqus_shortname + '.disqus.com/embed.js';
            (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
        })();
      noscript Please enable JavaScript to view the <a href="http://disqus.com/?ref_noscript">comments powered by Disqus.</a>
      a(href="http://disqus.com" class="dsq-brlink") comments powered by <span class="logo-disqus">Disqus</span>

    if toc.length > 1
      nav.post-toc(aria-label="On this page")
        h2.post-toc-label On this page
        ol.post-toc-list
          each heading in toc
            li
              a(href='#' + heading.id) !{heading.text}

  link(rel="stylesheet", href="/style/inlinecpc.css")
  script(type="text/javascript", src="/js/copy-code.js")
  script(type="text/javascript", src="/js/post-toc.js")
