doctype html
include mixins
html(lang="en")
  head
    meta(charset="utf-8")
    script(type="text/javascript").
      var _sf_startpt=(new Date()).getTime()
    script(async, src="https://www.googletagmanager.com/gtag/js?id=G-TE4SWRGR9E")
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-TE4SWRGR9E');

    block title
      title www.thecodebarbarian.com
    meta( name="viewport" content="width=device-width, initial-scale=1")
    link( href='https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap',
          rel='stylesheet',
          type='text/css')
    link( href="/style/style.css",
          rel="stylesheet"
          type="text/css")
    link( href="/style/github.css",
          rel="stylesheet"
          type="text/css")

    block opengraphTags

  body
    header.site-header
      .site-header-inner
        a.site-brand(href="/")
          img.site-logo(src='/images/Barbarian_Head.png', alt="")
          span.site-name The Code Barbarian
        nav.site-nav
          a.site-nav-link(href="/", class={ 'is-current': current === 'home' }) Home
          a.site-nav-link(href="/posts.html", class={ 'is-current': current === 'posts' }) All posts

    main.site-main
      block content

    footer.site-footer
      .site-footer-inner
        span Written by Valeri Karpov
        span.site-footer-links
          a(href="https://www.twitter.com/code_barbarian") Twitter
          a(href="https://www.github.com/vkarpov15") GitHub
          a(href="/feed.xml") RSS
          a(href="/ebooks.html") Ebooks
